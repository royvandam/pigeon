{
    "go.alternateTools": {
        "go": "$(bash \"${workspaceFolder}/scripts/vscode-settings.sh\" --get-go-path)",
        "gopls": "$(bash \"${workspaceFolder}/scripts/vscode-settings.sh\" --get-gopls-path)",
        "goimports": "$(bash \"${workspaceFolder}/scripts/vscode-settings.sh\" --get-goimports-path)"
    },
    "go.toolsEnvVars": {
        "PATH": "$(bash \"${workspaceFolder}/scripts/vscode-settings.sh\" --get-env-path)",
        "TMPDIR": "/tmp",
        "TMP": "/tmp",
        "TEMP": "/tmp"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    }
}
